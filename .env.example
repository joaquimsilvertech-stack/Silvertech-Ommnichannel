# =============================================================================
# SilverTech Omnichannel — variáveis de ambiente (exemplo)
# Copie para `.env` e preencha os valores "replace-with-*".
# =============================================================================

DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-with-local-secret
FIELD_ENCRYPTION_KEY=replace-with-existing-encryption-key

# ALLOWED_HOSTS é aplicado mesmo com DEBUG=True (settings lê do env).
# Se usar túnel (ngrok/cloudflared) para receber webhooks da Evolution,
# ACRESCENTE o domínio do túnel aqui, senão todo webhook vira 400 DisallowedHost.
# Ex.: ...,host.docker.internal,seu-tunel.ngrok-free.dev
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Banco da aplicação
# -----------------------------------------------------------------------------
POSTGRES_DB=silvertech
POSTGRES_USER=silvertech_user
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
DATABASE_URL=

# -----------------------------------------------------------------------------
# Redis — dbs separados de propósito:
#   db 0 = Celery (broker/result) + Channels/eventstream
#   db 1 = Evolution API (definido no docker-compose.yml)
#   db 2 = cache do Django (throttle do DRF, QR code)
# Não aponte o cache para o db 0: um `cache.clear()` apagaria a fila do Celery.
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Evolution API (cliente do Django)
# EVOLUTION_API_KEY deve ser IDÊNTICA a EVOLUTION_AUTHENTICATION_API_KEY abaixo,
# que é a chave configurada no container da Evolution.
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace-with-local-evolution-api-key
EVOLUTION_INSTANCE_NAME=silvertech_whatsapp
EVOLUTION_API_TIMEOUT_SECONDS=30

# URL pública que a Evolution usa para ENTREGAR webhooks ao backend.
# Regras (validadas em build_evolution_channel_webhook_url):
#   sem espaços, sem query string, sem fragmento (#), sem usuário/senha.
#   HTTPS só é obrigatório quando DJANGO_ENV=production.
# Opções em desenvolvimento:
#   a) Evolution em Docker na mesma máquina (sem túnel):
#      http://host.docker.internal:8000
#   b) Túnel público (permite inspecionar os payloads em http://127.0.0.1:4040):
#      https://seu-tunel.ngrok-free.dev
# ATENÇÃO: a URL do ngrok muda a cada reinício no plano free. Ao trocar,
# atualize aqui E no ALLOWED_HOSTS, reinicie o uvicorn e provisione um canal novo
# (canais antigos ficam com webhook apontando para a URL morta).
EVOLUTION_WEBHOOK_PUBLIC_BASE_URL=http://host.docker.internal:8000

EVOLUTION_WEBHOOK_MAX_BODY_BYTES=524288
EVOLUTION_WEBHOOK_DEDUP_TTL_SECONDS=86400
EVOLUTION_QR_TTL_SECONDS=120
EVOLUTION_EVENT_PROCESSING_STALE_SECONDS=300

# -----------------------------------------------------------------------------
# Container da Evolution (consumido pelo docker-compose.yml)
# -----------------------------------------------------------------------------
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=replace-with-local-evolution-db-password
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_AUTHENTICATION_API_KEY=replace-with-local-evolution-authentication-key

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
SENTRY_DSN=
